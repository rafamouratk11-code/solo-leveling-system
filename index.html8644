<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<!-- SYSTEM DAILY RESET FIX v2026-09-29 -->
<title>SYSTEM — THE PLAYER</title>
<style>
:root{
  --bg:#050509; --panel:#0c0b14; --panel2:#11101c; --purple:#9b5cff;
  --purple2:#c08cff; --text:#f4efff; --muted:#8f8aa0; --line:#29233a;
  --green:#64f7b2; --red:#ff5f7a; --gold:#ffd36b;
}
*{box-sizing:border-box}
body{
  margin:0;background:
  radial-gradient(circle at 50% -10%,#26104a 0,#0b0714 32%,var(--bg) 70%);
  color:var(--text);font-family:Arial,Helvetica,sans-serif;min-height:100vh;
}
body:before{
  content:"";position:fixed;inset:0;pointer-events:none;opacity:.13;
  background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px);
  background-size:40px 40px;mask-image:linear-gradient(to bottom,black,transparent 70%);
}
.app{max-width:900px;margin:auto;padding:18px 14px 50px}
header{text-align:center;padding:14px 8px 18px}
.system-title{font-size:clamp(34px,9vw,68px);font-weight:900;letter-spacing:.22em;text-shadow:0 0 10px #9b5cff,0 0 35px #6b25d8}
.subtitle{font-size:11px;letter-spacing:.25em;color:var(--muted);margin-top:8px}
.player-card,.panel{
  background:linear-gradient(145deg,rgba(18,15,29,.96),rgba(7,7,12,.96));
  border:1px solid var(--line);box-shadow:0 0 25px rgba(110,44,200,.13),inset 0 0 30px rgba(120,50,220,.03);
  border-radius:14px;
}
.player-card{padding:18px;margin-bottom:14px}
.player-top{display:flex;justify-content:space-between;gap:10px;align-items:center}
.label{color:var(--muted);font-size:11px;letter-spacing:.18em}
.player-name{font-size:25px;font-weight:900;letter-spacing:.1em}
.level{font-size:24px;font-weight:900;color:var(--purple2)}
.xp-row{display:flex;justify-content:space-between;font-size:12px;margin:14px 0 7px;color:#c9c2d7}
.bar{height:13px;border:1px solid #3d3154;background:#08070d;border-radius:20px;overflow:hidden}
.fill{height:100%;width:0;background:linear-gradient(90deg,#5c1bd4,#b86cff);box-shadow:0 0 14px #9b5cff;transition:width .4s}
.mini-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:14px}
.mini{background:#090812;border:1px solid var(--line);border-radius:10px;padding:10px;text-align:center}
.mini b{display:block;font-size:18px}.mini span{font-size:9px;color:var(--muted);letter-spacing:.12em}
nav{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin:14px 0}
nav button,.btn{
  border:1px solid var(--line);background:#0b0912;color:#cfc7dc;border-radius:9px;
  padding:11px 7px;font-weight:800;font-size:11px;letter-spacing:.08em;cursor:pointer;
}
nav button.active,nav button:hover,.btn.primary{border-color:#8c4de9;color:white;background:#1b102c;box-shadow:0 0 13px rgba(155,92,255,.2)}
.view{display:none}.view.active{display:block}
.panel{padding:16px;margin-bottom:12px}
.panel-title{font-size:13px;letter-spacing:.16em;color:var(--purple2);font-weight:900;margin-bottom:13px}
.quest{
  display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;
  padding:13px 0;border-bottom:1px solid #1d1928
}
.quest:last-child{border-bottom:0}
.quest h3{margin:0 0 5px;font-size:14px}.quest p{margin:0;color:var(--muted);font-size:11px}
.quest-right{text-align:right;min-width:105px}
.quest-xp{color:var(--gold);font-weight:900;font-size:12px;margin-bottom:7px}
.quest input{width:90px;padding:8px;border-radius:7px;border:1px solid #382d4b;background:#07060b;color:white;text-align:center}
.done{color:var(--green);font-size:11px;font-weight:900}
.stats-grid,.skill-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}
.stat,.skill{background:#090812;border:1px solid var(--line);border-radius:10px;padding:12px}
.stat span{font-size:10px;color:var(--muted);letter-spacing:.1em}.stat b{display:block;font-size:22px;margin-top:4px}
.skill h3{margin:0;font-size:13px}.skill small{color:var(--muted);display:block;margin:5px 0 9px}
.skill .bar{height:7px}.skill.locked{opacity:.45}
.skill .req{font-size:9px;color:var(--muted);margin-top:6px}
.actions{display:flex;flex-wrap:wrap;gap:8px}
textarea{width:100%;min-height:120px;background:#07060b;color:#ddd;border:1px solid var(--line);border-radius:9px;padding:10px}
.toast{
  position:fixed;left:50%;bottom:22px;transform:translate(-50%,20px);opacity:0;
  background:#170d28;border:1px solid #8c4de9;color:white;padding:12px 18px;border-radius:10px;
  box-shadow:0 0 25px rgba(155,92,255,.35);transition:.25s;z-index:10;text-align:center;font-size:12px
}
.toast.show{opacity:1;transform:translate(-50%,0)}
.empty{color:var(--muted);font-size:12px;line-height:1.6}
@media(max-width:600px){
  .app{padding:10px 10px 35px}.mini-grid{grid-template-columns:repeat(3,1fr)}
  nav button{font-size:9px;padding:10px 3px}.quest{grid-template-columns:1fr auto}
  .stats-grid,.skill-grid{grid-template-columns:1fr}.system-title{letter-spacing:.14em}
}

/* Visual assets carried over from the previous SYSTEM website */
header {
  background-image:
    linear-gradient(90deg,rgba(5,4,10,.82),rgba(9,4,18,.35),rgba(5,4,10,.82)),
    url("data:image/jpeg;base64,");
  background-size:cover;
  background-position:center;
}
.player-card {
  background-image:
    linear-gradient(90deg,rgba(8,6,14,.94),rgba(8,6,14,.62),rgba(8,6,14,.90)),
    url("data:image/jpeg;base64,");
  background-size:cover;
  background-position:center;
}
.player-name {
  text-shadow:0 0 14px #9b5cff;
}
.panel {
  background-image:
    linear-gradient(145deg,rgba(18,15,29,.93),rgba(7,7,12,.96));
}
#settings .panel {
  background-image:
    linear-gradient(rgba(8,6,14,.82),rgba(8,6,14,.92)),
    url("data:image/jpeg;base64,");
  background-size:cover;
  background-position:center;
}
.avatar-art {
  background-image:
    linear-gradient(rgba(7,5,12,.22),rgba(7,5,12,.38)),
    url("data:image/jpeg;base64,");
  background-size:cover;
  background-position:center;
}


/* ===== CLASSIC SOLO-LEVELING HUD REDESIGN ===== */
:root{
 --bg:#030308; --panel:#080812; --panel2:#0d0b18; --purple:#9b4dff;
 --purple2:#d5a7ff; --cyan:#b8d8ff; --text:#f7f2ff; --muted:#77718b;
 --line:#34234d; --gold:#d7b0ff; --green:#8dffc9;
}
body{
 background:
 radial-gradient(ellipse at 55% 0%,rgba(125,40,255,.20),transparent 34%),
 radial-gradient(ellipse at 100% 55%,rgba(76,24,150,.12),transparent 38%),
 #020207;
 font-family:"Trebuchet MS",Arial,sans-serif;
 overflow-x:hidden;
}
body:after{
 content:"";position:fixed;inset:0;pointer-events:none;z-index:0;
 background:linear-gradient(115deg,transparent 0 48%,rgba(155,77,255,.025) 49%,transparent 50%),
 repeating-linear-gradient(0deg,transparent 0 5px,rgba(255,255,255,.012) 6px);
}
.app{position:relative;z-index:1;max-width:1180px;padding:18px 16px 60px}
header{
 min-height:145px;display:flex;flex-direction:column;justify-content:center;
 text-align:left!important;padding:18px 26px!important;margin-bottom:12px;
 border:1px solid #3c2755!important;border-radius:4px!important;
 box-shadow:0 0 35px rgba(116,39,210,.18),inset 0 0 70px rgba(88,22,170,.12);
 position:relative;overflow:hidden;
}
header:after{
 content:"";position:absolute;right:-40px;top:-100px;width:360px;height:360px;
 border-radius:50%;background:radial-gradient(circle,rgba(159,72,255,.24),transparent 62%);
}
.system-title{
 font-size:clamp(42px,8vw,78px)!important;letter-spacing:.30em!important;
 text-shadow:0 0 7px #fff,0 0 20px #9b4dff,0 0 45px #6516c7!important;
 position:relative;z-index:2;
}
.subtitle{font-size:11px!important;letter-spacing:.38em!important;color:#aaa0bd!important;position:relative;z-index:2}

.player-card{
 border-radius:4px!important;padding:0!important;margin-bottom:12px!important;
 display:grid;grid-template-columns:145px 1fr 220px;gap:0;overflow:hidden;
 border:1px solid #49305f!important;
 background:linear-gradient(135deg,#0b0913,#05050b 65%,#0c0715)!important;
 box-shadow:0 0 28px rgba(115,42,210,.20),inset 0 0 45px rgba(130,45,240,.04)!important;
 min-height:205px;
}
.player-card:before{
 content:"";display:block;grid-row:1/2;grid-column:1;
 background:
 radial-gradient(circle at 50% 38%,rgba(166,94,255,.28),transparent 25%),
 linear-gradient(145deg,rgba(31,16,51,.9),rgba(4,4,9,.98));
 border-right:1px solid #39244d;
}
.player-top{
 grid-column:2;display:block!important;padding:24px 22px 8px;align-self:center;
}
.avatar-art{display:none}
.player-top .label{font-size:10px;color:#8e839f;letter-spacing:.35em}
.player-name{font-size:31px!important;letter-spacing:.25em!important;margin-top:4px;text-shadow:0 0 14px rgba(188,125,255,.5)}
.level{font-size:27px!important;margin-top:12px;text-shadow:0 0 12px #9b4dff}
.xp-row{margin:15px 0 7px!important;font-size:11px!important;letter-spacing:.04em}
.bar{height:14px!important;border-radius:1px!important;border:1px solid #503369!important;background:#05040a!important}
.fill{background:linear-gradient(90deg,#4d0f9f,#9e50ff 70%,#d6a2ff)!important;box-shadow:0 0 16px #9b4dff!important}
.mini-grid{grid-template-columns:repeat(3,1fr)!important;margin-top:12px!important;gap:6px!important}
.mini{border-radius:2px!important;background:#07060d!important;border:1px solid #282033!important;padding:7px!important}
.mini b{font-size:15px!important;color:#eee}
.mini span{font-size:8px!important;letter-spacing:.18em!important}
.player-card:after{
 content:"NEXT LEVEL\A\A LV. " attr(data-next);white-space:pre;
 grid-column:3;grid-row:1;display:flex;align-items:center;justify-content:center;text-align:center;
 padding:18px;color:#a88bbd;font-size:11px;letter-spacing:.22em;
 border-left:1px solid #30203f;background:linear-gradient(180deg,rgba(45,20,75,.28),rgba(6,5,11,.5));
}
nav{
 grid-template-columns:repeat(5,1fr)!important;gap:0!important;margin:0 0 14px!important;
 border:1px solid #34234a;background:#07060c;border-radius:3px;overflow:hidden;
}
nav button{
 border:0!important;border-right:1px solid #2a1c38!important;border-radius:0!important;
 background:transparent!important;padding:12px 8px!important;color:#81758f!important;
 letter-spacing:.16em!important;font-size:10px!important;
}
nav button:last-child{border-right:0!important}
nav button.active,nav button:hover{
 color:#eee!important;background:linear-gradient(180deg,#1d0d30,#0e0916)!important;
 box-shadow:inset 0 -2px #a45cff,0 0 18px rgba(154,76,255,.12)!important;
}
main{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(240px,.8fr);gap:12px}
.view.active{display:contents}
.panel{
 border-radius:3px!important;padding:17px!important;margin-bottom:12px!important;
 border:1px solid #34234a!important;background:linear-gradient(145deg,rgba(12,9,19,.98),rgba(4,4,8,.98))!important;
 box-shadow:inset 0 0 28px rgba(120,45,220,.025),0 0 22px rgba(80,25,130,.08)!important;
}
.panel-title{
 font-size:12px!important;letter-spacing:.28em!important;color:#bd8bea!important;
 border-bottom:1px solid #281b37;padding-bottom:11px;margin-bottom:7px!important;
}
.quest{
 grid-template-columns:1fr auto!important;padding:13px 2px!important;
 border-bottom:1px solid #21172c!important;
}
.quest h3{font-size:12px!important;letter-spacing:.08em}
.quest p{font-size:10px!important}
.quest-right{min-width:112px!important}
.quest-xp{font-size:11px!important;color:#c89aff!important}
.quest input{
 width:78px!important;border-radius:2px!important;background:#05040a!important;border:1px solid #3b2850!important;
}
.btn{border-radius:2px!important;background:#0a0710!important;border-color:#3a2750!important;letter-spacing:.12em!important}
.btn.primary{background:#180c27!important;border-color:#8f4de4!important}
.stats-grid,.skill-grid{grid-template-columns:repeat(2,1fr)!important}
.stat,.skill{border-radius:2px!important;background:#07060d!important;border-color:#2a1d37!important}
.skill h3{letter-spacing:.06em}
.empty{font-size:10px!important;letter-spacing:.05em}
.toast{border-radius:2px!important}
@media(max-width:760px){
 .app{padding:9px 8px 35px}
 header{min-height:120px;padding:16px!important}
 .system-title{font-size:39px!important}
 .player-card{grid-template-columns:82px 1fr!important;min-height:190px}
 .player-card:before{grid-column:1}
 .player-top{grid-column:2;padding:18px 14px 12px!important}
 .player-card:after{display:none}
 main{display:block}
 nav button{font-size:8px!important;letter-spacing:.08em!important}
 .panel{padding:13px!important}
 .stats-grid,.skill-grid{grid-template-columns:1fr!important}
}


.hud-line{display:flex;justify-content:space-between;padding:5px 4px;color:#62556f;font-size:8px;letter-spacing:.22em;border-left:2px solid #6e35a4;margin:0 0 6px}
@media(max-width:600px){.hud-line{font-size:7px}}

/* CLASSIC SYSTEM PLAYER ART — large image beside the XP bar */
.player-card {
  position:relative;
}
.player-card:before { display:none !important; }
.player-visual {
  grid-column:1;
  grid-row:1;
  min-height:205px;
  background:
    linear-gradient(90deg,rgba(5,3,10,.05),rgba(5,3,10,.18)),
    url("data:image/jpeg;base64,") center/cover no-repeat;
  border-right:1px solid #39244d;
  position:relative;
  overflow:hidden;
}
.player-visual:after {
  content:"";
  position:absolute;inset:0;
  background:linear-gradient(90deg,transparent 55%,rgba(8,5,14,.72) 100%);
  pointer-events:none;
}
@media(max-width:600px){
  .player-card{grid-template-columns:92px 1fr!important;min-height:190px}
  .player-visual{min-height:190px;grid-column:1}
  .player-top{grid-column:2!important;padding:18px 14px 12px!important}
}
</style>
</head>
<body>
<div class="app">
<header>
  <div class="system-title">SYSTEM</div>
  <div class="subtitle">THE PLAYER HAS ENTERED THE SYSTEM.</div>
</header>
<div class="hud-line"><span>PLAYER STATUS // SYSTEM ONLINE</span><span>CLASS: PLAYER</span></div>
<section class="player-card">
  <div class="player-visual" aria-hidden="true"></div>
  <div class="player-top">
    <div><div class="label">PLAYER</div><div class="player-name">PLAYER</div></div>
    <div class="level" id="levelText">LV. 1</div>
  </div>
  <div class="xp-row"><span id="xpText">0 / 1200 XP</span><span id="streakText">🔥 0 DAY STREAK</span></div>
  <div class="bar"><div class="fill" id="xpFill"></div></div>
  <div class="mini-grid">
    <div class="mini"><b id="todayXP">0</b><span>TODAY XP</span></div>
    <div class="mini"><b id="questCount">0</b><span>QUESTS DONE</span></div>
    <div class="mini"><b id="totalXP">0</b><span>TOTAL XP</span></div>
  </div>
</section>

<nav>
  <button class="active" data-view="home">HOME</button>
  <button data-view="quests">QUESTS</button>
  <button data-view="stats">STATS</button>
  <button data-view="skills">LEVEL UP</button>
  <button data-view="settings">SETTINGS</button>
</nav>

<main>
<section id="home" class="view active">
  <div class="panel">
    <div class="panel-title">SYSTEM STATUS</div>
    <div class="empty">Complete daily quests to gain XP. Quest rewards are fixed — doing extra reps or distance does not give extra XP.</div>
  </div>
  <div class="panel">
    <div class="panel-title">TODAY'S PROGRESS</div>
    <div id="homeProgress"></div>
  </div>
</section>

<section id="quests" class="view">
  <div class="panel">
    <div class="panel-title">DAILY QUESTS</div>
    <div id="questList"></div>
  </div>
</section>

<section id="stats" class="view">
  <div class="panel">
    <div class="panel-title">PLAYER STATS</div>
    <div class="stats-grid" id="statsGrid"></div>
  </div>
</section>

<section id="skills" class="view">
  <div class="panel">
    <div class="panel-title">SKILL TREE</div>
    <div class="skill-grid" id="skillGrid"></div>
  </div>
</section>

<section id="settings" class="view">
  <div class="panel">
    <div class="panel-title">SYSTEM DATA</div>
    <div class="actions">
      <button class="btn primary" id="exportBtn">EXPORT SAVE</button>
      <button class="btn" id="importBtn">IMPORT SAVE</button>
      <button class="btn" id="resetBtn">RESET SYSTEM</button>
    </div>
    <br>
    <textarea id="saveBox" placeholder="Exported save data appears here. Paste save data here to import it."></textarea>
    <p class="empty">Your progress is stored locally in this browser for now. Cloud login/save can be added later.</p>
  </div>
</section>
</main>
</div>
<div class="toast" id="toast"></div>

<script>
const QUESTS=[
 {id:'run',name:'RUN 10 KM',target:10,unit:'km',xp:100,key:'distance'},
 {id:'push',name:'DO 100 PUSH-UPS',target:100,unit:'reps',xp:100,key:'pushups'},
 {id:'squat',name:'DO 100 SQUATS',target:100,unit:'reps',xp:100,key:'squats'},
 {id:'sit',name:'DO 100 SIT-UPS',target:100,unit:'reps',xp:100,key:'situps'},
 {id:'pages',name:'READ 10 PAGES',target:10,unit:'pages',xp:75,key:'pages'},
 {id:'vocab',name:'STUDY VOCABULARY',target:10,unit:'min',xp:75,key:'vocab'},
 {id:'learn',name:'LEARN FOR 15 MINUTES',target:15,unit:'min',xp:75,key:'learning'}
];

const SKILLS=[
 ['FAST READER','200 pages',200,'pages',1],
 ['IRON WILL','50 quests',50,'quests',5],
 ['SHADOW STEP','100 km',100,'distance',3],
 ['RAW POWER','2,000 push-ups',2000,'pushups',5],
 ['IRON LEGS','2,000 squats',2000,'squats',5],
 ['CORE BREAKER','2,000 sit-ups',2000,'situps',5],
 ['KNOWLEDGE CORE','500 vocab minutes',500,'vocab',7],
 ['FOCUS MODE','500 learning minutes',500,'learning',10],
 ['NIGHT RUNNER','200 km',200,'distance',10],
 ['ARCHIVIST','1,000 pages',1000,'pages',10],
 ['DISCIPLINE','150 quests',150,'quests',10],
 ['VOID WALKER','500 km',500,'distance',15],
 ['GRAND ARCHIVIST','3,000 pages',3000,'pages',15],
 ['ABSOLUTE DISCIPLINE','300 quests',300,'quests',15],
 ['MASTER MIND','1,500 vocab minutes',1500,'vocab',15],
 ['DEEP FOCUS','2,000 learning minutes',2000,'learning',15],
 ['RAW FORCE','10,000 push-ups',10000,'pushups',15],
 ['TITAN LEGS','10,000 squats',10000,'squats',15],
 ['CORE OF STEEL','10,000 sit-ups',10000,'situps',15],
 ['SYSTEM MASTER','Level 20 + 500 quests',500,'specialMaster',20],
 ['MONARCH','Reach Level 30',30,'specialMonarch',30]
];

const defaultState={
 level:1,xp:0,totalXP:0,totalQuests:0,streak:0,lastDate:'',
 totals:{distance:0,pushups:0,squats:0,situps:0,pages:0,vocab:0,learning:0},
 today:{date:'',done:{}},
 history:{}
};
let state=JSON.parse(localStorage.getItem('soloSystemSave')||'null')||structuredClone(defaultState);

// Use the player's local calendar date, not UTC. This makes the daily reset
// happen at local midnight instead of at a different UTC time.
function today(){
 const d=new Date();
 return [d.getFullYear(),String(d.getMonth()+1).padStart(2,'0'),String(d.getDate()).padStart(2,'0')].join('-');
}
function ensureToday(){
 const d=today();
 if(!state.history) state.history={};
 if(!state.today || !state.today.date){
   state.today={date:d,done:{}};
   save();
   return false;
 }
 if(state.today.date!==d){
   const oldDate=state.today.date;
   const oldDone={...(state.today.done||{})};
   const oldXP=Object.keys(oldDone).reduce((sum,id)=>{
     const q=QUESTS.find(q=>q.id===id);
     return sum+(q?q.xp:0);
   },0);

   // Archive the previous day's quests. If that day's XP was never credited
   // (for example because an older version of the SYSTEM only saved the
   // answers), credit it once now. This also prevents double-crediting later.
   const previous=state.history[oldDate]||{};
   state.history[oldDate]={
     done:oldDone,
     xp:oldXP,
     xpCredited: previous.xpCredited===true || oldXP===0 ? true : true
   };

   // Recovery for old saves: the completed quests are evidence of completion,
   // so restore their fixed rewards exactly once when the day rolls over.
   if(previous.xpCredited!==true && oldXP>0){
     state.xp+=oldXP;
     state.totalXP+=oldXP;
     let leveled=0;
     while(state.xp>=reqForLevel(state.level)){
       state.xp-=reqForLevel(state.level);
       state.level++;
       leveled++;
     }
     if(leveled) setTimeout(()=>toast('LEVEL UP!  →  LV. '+state.level),0);
   }

   state.today={date:d,done:{}};
   save();
   return true;
 }
 return false;
}
function save(){localStorage.setItem('soloSystemSave',JSON.stringify(state))}
function watchForNewDay(){
  if(ensureToday()){
    render();
    toast('NEW DAY  •  DAILY QUESTS RESET');
  }
}
function reqForLevel(l){
 if(l<=5)return 1200;if(l<=10)return 2000;if(l<=15)return 2300;return 2700;
}
function toast(msg){
 const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');
 clearTimeout(window.__toast);window.__toast=setTimeout(()=>t.classList.remove('show'),2200)
}
function addXP(amount){
 state.xp+=amount;state.totalXP+=amount;
 let leveled=0;
 while(state.xp>=reqForLevel(state.level)){state.xp-=reqForLevel(state.level);state.level++;leveled++}
 if(leveled)toast('LEVEL UP!  →  LV. '+state.level);
}
function completeQuest(q,value){
 ensureToday();
 if(state.today.done[q.id])return;
 if(!Number.isFinite(value)||value<q.target){toast('Requirement not reached.');return}
 state.today.done[q.id]=value;
 state.totals[q.key]+=value;
 state.totalQuests++;
 addXP(q.xp);
 updateStreak();
 save();render();toast('QUEST COMPLETE  +'+q.xp+' XP')
}
function updateStreak(){
 const d=today();
 const last=state.lastDate;
 if(last===d)return;
 if(!last){state.streak=1}
 else{
   const diff=(new Date(d)-new Date(last))/86400000;
   state.streak=diff===1?state.streak+1:1;
 }
 state.lastDate=d;
}
function render(){
 ensureToday();
 const req=reqForLevel(state.level);
 document.getElementById('levelText').textContent='LV. '+state.level;
 document.getElementById('xpText').textContent=state.xp+' / '+req+' XP';
 document.getElementById('xpFill').style.width=Math.min(100,state.xp/req*100)+'%';
 document.getElementById('streakText').textContent='🔥 '+state.streak+' DAY STREAK';
 document.getElementById('todayXP').textContent=QUESTS.reduce((a,q)=>a+(state.today.done[q.id]?q.xp:0),0);
 document.getElementById('questCount').textContent=state.totalQuests;
 document.getElementById('totalXP').textContent=state.totalXP;
 renderQuests();renderHome();renderStats();renderSkills();
}
function renderQuests(){
 const el=document.getElementById('questList');el.innerHTML='';
 QUESTS.forEach(q=>{
  const done=state.today.done[q.id];
  const div=document.createElement('div');div.className='quest';
  div.innerHTML=`<div><h3>${q.name}</h3><p>Target: ${q.target} ${q.unit} • Fixed reward</p></div>
  <div class="quest-right">${done?`<div class="done">✓ ${done} ${q.unit}</div>`:
  `<div class="quest-xp">+${q.xp} XP</div><input type="number" min="0" step="0.1" id="in-${q.id}" placeholder="${q.target}"><br><button class="btn" style="margin-top:6px" data-q="${q.id}">COMPLETE</button>`}</div>`;
  el.appendChild(div);
 });
 el.querySelectorAll('button[data-q]').forEach(b=>b.onclick=()=>{
   const q=QUESTS.find(x=>x.id===b.dataset.q);
   const value=parseFloat(document.getElementById('in-'+q.id).value);
   completeQuest(q,value);
 });
}
function renderHome(){
 const done=QUESTS.filter(q=>state.today.done[q.id]).length;
 document.getElementById('homeProgress').innerHTML=
 `<div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:7px"><span>${done} / ${QUESTS.length} quests complete</span><span>${Math.round(done/QUESTS.length*100)}%</span></div>
 <div class="bar"><div class="fill" style="width:${done/QUESTS.length*100}%"></div></div>`;
}
function renderStats(){
 const names=[
  ['DISTANCE','distance','km'],['PUSH-UPS','pushups','reps'],['SQUATS','squats','reps'],
  ['SIT-UPS','situps','reps'],['PAGES READ','pages','pages'],['VOCAB STUDIED','vocab','min'],['LEARNING','learning','min']
 ];
 document.getElementById('statsGrid').innerHTML=names.map(x=>
 `<div class="stat"><span>${x[0]}</span><b>${state.totals[x[1]]} ${x[2]}</b></div>`).join('');
}
function renderSkills(){
 document.getElementById('skillGrid').innerHTML=SKILLS.map(s=>{
  const [name,desc,target,key,levelReq]=s;
  let value=0,unlocked=state.level>=levelReq;
  if(key==='specialMaster'){value=state.totalQuests;unlocked=state.level>=20&&state.totalQuests>=500}
  else if(key==='specialMonarch'){value=state.level;unlocked=state.level>=30}
  else value=state.totals[key]||0;
  const pct=key.startsWith('special')?(unlocked?100:Math.min(100,value/target*100)):Math.min(100,value/target*100);
  return `<div class="skill ${unlocked?'':'locked'}"><h3>${unlocked?'✦':'🔒'} ${name}</h3>
  <small>${desc}</small><div class="bar"><div class="fill" style="width:${pct}%"></div></div>
  <div class="req">${unlocked?'UNLOCKED':'Requires LV. '+levelReq} • ${Math.min(value,target)} / ${target}</div></div>`
 }).join('');
}
document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>{
 document.querySelectorAll('nav button').forEach(x=>x.classList.remove('active'));
 document.querySelectorAll('.view').forEach(x=>x.classList.remove('active'));
 b.classList.add('active');document.getElementById(b.dataset.view).classList.add('active');
});
document.getElementById('exportBtn').onclick=()=>{
 document.getElementById('saveBox').value=btoa(unescape(encodeURIComponent(JSON.stringify(state))));
 toast('SAVE EXPORTED')
};
document.getElementById('importBtn').onclick=()=>{
 try{
  const raw=decodeURIComponent(escape(atob(document.getElementById('saveBox').value.trim())));
  const incoming=JSON.parse(raw);
  if(!incoming.level||!incoming.totals)throw new Error();
  if(!incoming.today) incoming.today={date:today(),done:{}};
  if(!incoming.history) incoming.history={};
  state=incoming;ensureToday();save();render();toast('SAVE IMPORTED')
 }catch(e){toast('INVALID SAVE DATA')}
};
document.getElementById('resetBtn').onclick=()=>{
 if(confirm('Reset the entire SYSTEM? This cannot be undone.')){
  state=structuredClone(defaultState);state.today={date:today(),done:{}};save();render();toast('SYSTEM RESET')
 }
};
ensureToday();render(); setInterval(watchForNewDay,1000); document.addEventListener('visibilitychange',watchForNewDay);

// Check regularly so the SYSTEM rolls over automatically at local midnight,
// even if the page stays open.
let __systemDate=today();
setInterval(()=>{
  const d=today();
  if(d!==__systemDate){
    __systemDate=d;
    watchForNewDay();
  }
},30000);
</script>
</body>
</html>
